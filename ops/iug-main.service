[Unit]
Description=IUG Engineering Club main portal
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=iugdeploy
Group=iugdeploy
WorkingDirectory=/var/www/main/current
Environment=NODE_ENV=production
EnvironmentFile=/var/www/main/shared/.env
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/www/main

[Install]
WantedBy=multi-user.target

