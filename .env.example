DATABASE_URL="postgresql://engineering:engineering@localhost:55432/engineering_club?schema=public"
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
EMAIL_VERIFICATION_SECRET="replace-with-a-different-random-secret-of-at-least-32-characters"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="a7med.m.1234@gmail.com"
SMTP_PASS="replace-with-your-smtp-app-password"
SMTP_FROM="النادي الهندسي للطلاب <a7med.m.1234@gmail.com>"
SEED_ADMIN_EMAIL="admin@gmail.com"
SEED_ADMIN_PASSWORD="replace-with-a-random-password-of-at-least-12-characters"
# Vercel injects and rotates this token. Locally, obtain it with `vercel env pull`.
VERCEL_OIDC_TOKEN="vercel_oidc_token_from_vercel_env_pull"

# Public store: activity covers and galleries only.
BLOB_PUBLIC_STORE_ID="store_your-public-store-id"

# Private store: chat, voice, student/member media, and collaboration files.
BLOB_PRIVATE_STORE_ID="store_your-private-store-id"

# Optional local-only fallbacks when Vercel OIDC is unavailable.
