generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// ENUMS
// =========================================================

enum Role {
  STUDENT
  MEMBER
  ADMIN
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StudyLevel {
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
  GRADUATE
}

enum ComplaintType {
  COMPLAINT
  ORGANIZATIONAL_PROBLEM
  IMPROVEMENT_SUGGESTION
  INQUIRY
  OTHER
}

enum PreferredActivityType {
  TRAINING_COURSE
  WORKSHOP
  TECH_LECTURE
  COMPETITION
  DISCUSSION_SESSION
  PRACTICAL_TRAINING
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EntityType {
  TRAINER
  COMPANY
  EDUCATIONAL_INSTITUTION
  CHARITY
  TECH_COMMUNITY
  INDIVIDUAL
  OTHER
}

enum CooperationType {
  TRAINING_COURSE
  WORKSHOP
  LECTURE
  EVENT_SPONSORSHIP
  STRATEGIC_PARTNERSHIP
  COMMUNITY_INITIATIVE
  OTHER
}

enum ContactRequestStatus {
  NEW
  IN_REVIEW
  RESOLVED
  CONTACTED
  ACCEPTED
  REJECTED
}

// =========================================================
// ACTIVITY FORM BUILDER
// =========================================================

enum ActivityFormQuestionType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  NUMBER
  SELECT
  RADIO
  CHECKBOX
}

enum ActivitySubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

// =========================================================
// MEMBER CHAT
// =========================================================

enum ChatConversationType {
  DIRECT
  GROUP
}

// =========================================================
// USER
// =========================================================

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String
  role              Role      @default(STUDENT)
  position          String?
  memberPermissions String[]  @default([])
  chatLastSeenAt    DateTime?
  // =====================================================
  // MEMBER PUBLIC PROFILE
  // =====================================================

  profileBio       String?
  profileSkills    String[] @default([])
  profileLinkedIn  String?
  profileGithub    String?
  profileInstagram String?

  profileCoverStoredName   String?
  profileCoverOriginalName String?
  profileCoverMime         String?
  profileCoverSize         Int?
  profileCoverUpdatedAt    DateTime?

  // =====================================================
  // STUDENT PROFILE
  // =====================================================

  studentNumber String?     @unique
  phone         String?
  studyLevel    StudyLevel?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // =====================================================
  // PROFILE IMAGE
  // =====================================================

  avatarStoredName   String?
  avatarOriginalName String?
  avatarMime         String?
  avatarSize         Int?
  avatarUpdatedAt    DateTime?

  // =====================================================
  // ACTIVITY REGISTRATIONS
  // =====================================================

  structureItem ClubStructureItem?

  activityFormSubmissions ActivityFormSubmission[]

  chatParticipants    ChatParticipant[]
  sentChatMessages    ChatMessage[]        @relation("ChatMessageSender")
  chatMessageReceipts ChatMessageReceipt[]
  chatTyping          ChatTyping[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
}

// =========================================================
// DEPARTMENT
// =========================================================

model Department {
  id          String  @id @default(cuid())
  nameAr      String
  nameEn      String
  slug        String  @unique
  coverImage  String
  detailImage String?
  sortOrder   Int     @default(0)

  users          User[]
  activities     ActivityDepartment[]
  guide          DepartmentGuide?
  structureItems ClubStructureItem[]

  complaints  Complaint[]
  suggestions Suggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// ACTIVITY
// =========================================================

