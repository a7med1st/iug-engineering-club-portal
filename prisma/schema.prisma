// =========================================================
// DEPARTMENT GUIDE
// =========================================================

model DepartmentGuide {
  id           String @id @default(cuid())
  departmentId String @unique

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  overview      String @default("")
  fitFor        String @default("")
  careersIncome String @default("")
  skillsCourses String @default("")
  comparisons   String @default("")
  faq           String @default("")

  updatedAt DateTime @updatedAt
}

// =========================================================
// CLUB STRUCTURE
// =========================================================

model ClubStructureItem {
  id    String @id @default(cuid())
  name  String
  title String

  level     Int @default(1)
  sortOrder Int @default(0)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  parentId String?
  parent   ClubStructureItem?  @relation("ClubStructureTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ClubStructureItem[] @relation("ClubStructureTree")

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([departmentId, sortOrder])
}

// =========================================================
// COMPLAINT
// =========================================================

model Complaint {
  id String @id @default(cuid())

  studentName String?
  contact     String?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  studyLevel StudyLevel

  type       ComplaintType
  details    String
  wantsReply Boolean

  status ContactRequestStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([departmentId, createdAt])
}

// =========================================================
// SUGGESTION
// =========================================================

model Suggestion {
  id String @id @default(cuid())

  studentName String
  whatsapp    String

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  studyLevel StudyLevel

  topics String?

  activityType  PreferredActivityType
  activityLevel ExperienceLevel

  projectIdea String

  experienceLevel ExperienceLevel

  status ContactRequestStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([departmentId, createdAt])
}

// =========================================================
// COLLABORATION REQUEST
// =========================================================

model CollaborationRequest {
  id String @id @default(cuid())

  entityName String
  entityType EntityType

  contactPerson String
  phone         String
  email         String
  socialUrl     String

  cooperationType CooperationType
  description     String
  field           String

  attachmentStoredName   String?
  attachmentOriginalName String?
  attachmentMime         String?
  attachmentSize         Int?

  additionalNotes String?

  status ContactRequestStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// =========================================================
// MEMBER CHAT MODELS
// =========================================================

model ChatConversation {
  id   String               @id @default(cuid())
  type ChatConversationType @default(DIRECT)
  name String?

  directKey     String?   @unique
  lastMessageAt DateTime?

  participants ChatParticipant[]
  messages     ChatMessage[]
  typingUsers  ChatTyping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastMessageAt])
}

model ChatParticipant {
  conversationId String
  userId         String

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  @@id([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  body String

  receipts ChatMessageReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

// =========================================================
// CHAT DELIVERY / READ RECEIPTS
// =========================================================

model ChatMessageReceipt {
  messageId String
  userId    String

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveredAt DateTime?
  readAt      DateTime?

  @@id([messageId, userId])
  @@index([userId, deliveredAt])
  @@index([userId, readAt])
}

model ChatTyping {
  conversationId String
  userId         String

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@id([conversationId, userId])
  @@index([expiresAt])
}

enum NotificationType {
  CHAT_MESSAGE
  ACTIVITY_APPROVED
  ACTIVITY_REJECTED
  ACTIVITY_NEW
  ACTIVITY_REMINDER
  SYSTEM
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?
  href  String?

  chatConversationId String?
  chatMessageId      String?

  reminderKey String? @unique

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, chatMessageId])
  @@index([userId, readAt, createdAt])
  @@index([chatConversationId])
}


model Certificate {
  id               String   @id @default(cuid())
  submissionId     String   @unique
  verificationCode String   @unique
  issuedAt         DateTime @default(now())
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  submission ActivityFormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([issuedAt])
  @@index([revokedAt])
}
