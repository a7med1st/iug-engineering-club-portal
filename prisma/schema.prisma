generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// ENUMS
// =========================================================

enum Role {
  STUDENT
  MEMBER
  ADMIN
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StudyLevel {
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
  GRADUATE
}

enum ComplaintType {
  COMPLAINT
  ORGANIZATIONAL_PROBLEM
  IMPROVEMENT_SUGGESTION
  INQUIRY
  OTHER
}

enum PreferredActivityType {
  TRAINING_COURSE
  WORKSHOP
  TECH_LECTURE
  COMPETITION
  DISCUSSION_SESSION
  PRACTICAL_TRAINING
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EntityType {
  TRAINER
  COMPANY
  EDUCATIONAL_INSTITUTION
  CHARITY
  TECH_COMMUNITY
  INDIVIDUAL
  OTHER
}

enum CooperationType {
  TRAINING_COURSE
  WORKSHOP
  LECTURE
  EVENT_SPONSORSHIP
  STRATEGIC_PARTNERSHIP
  COMMUNITY_INITIATIVE
  OTHER
}

enum ContactRequestStatus {
  NEW
  IN_REVIEW
  RESOLVED
  CONTACTED
  ACCEPTED
  REJECTED
}

// =========================================================
// ACTIVITY FORM BUILDER
// =========================================================

enum ActivityFormQuestionType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  NUMBER
  SELECT
  RADIO
  CHECKBOX
}

enum ActivitySubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

// =========================================================
// USER
// =========================================================

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         Role    @default(STUDENT)
  position     String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  activityFormSubmissions ActivityFormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// DEPARTMENT
// =========================================================

model Department {
  id         String @id @default(cuid())
  nameAr     String
  nameEn     String
  slug       String @unique
  coverImage String
  sortOrder  Int    @default(0)

  users          User[]
  activities     ActivityDepartment[]
  guide          DepartmentGuide?
  structureItems ClubStructureItem[]

  complaints  Complaint[]
  suggestions Suggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// ACTIVITY
// =========================================================

model Activity {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  startsAt    DateTime
  capacity    Int

  // للأنشطة القديمة التي كانت تستخدم Google Forms
  // الأنشطة الجديدة لن تحتاجه
  formUrl String?

  status ActivityStatus @default(PUBLISHED)

  departments ActivityDepartment[]

  // نموذج التسجيل الداخلي
  registrationForm ActivityRegistrationForm?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityDepartment {
  activityId   String
  departmentId String

  activity   Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([activityId, departmentId])
  @@index([departmentId])
}

// =========================================================
// ACTIVITY REGISTRATION FORM
// =========================================================

model ActivityRegistrationForm {
  id String @id @default(cuid())

  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  title       String @default("نموذج التسجيل")
  description String @default("")

  // الأدمن يستطيع فتح وإغلاق التسجيل
  isOpen Boolean @default(true)

  questions   ActivityFormQuestion[]
  submissions ActivityFormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// ACTIVITY FORM QUESTION
// =========================================================

model ActivityFormQuestion {
  id String @id @default(cuid())

  formId String
  form   ActivityRegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  // نص السؤال
  label String

  // SHORT_TEXT / RADIO / CHECKBOX ...
  type ActivityFormQuestionType

  required Boolean @default(false)

  placeholder String?
  helpText    String?

  // تستخدم مع:
  // SELECT
  // RADIO
  // CHECKBOX
  //
  // مثال:
  // ["المستوى الأول", "المستوى الثاني"]
  options Json?

  sortOrder Int @default(0)

  answers ActivityFormAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId, sortOrder])
}

// =========================================================
// ACTIVITY FORM SUBMISSION
// =========================================================

model ActivityFormSubmission {
  id String @id @default(cuid())

  formId String
  form   ActivityRegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  // المستخدم المسجل
  // Optional حتى نحافظ على التسجيل لو حُذف حساب الطالب مستقبلًا
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Snapshot لبيانات الطالب وقت التسجيل
  studentName       String
  studentEmail      String
  studentDepartment String?

  status ActivitySubmissionStatus @default(SUBMITTED)

  answers ActivityFormAnswer[]

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // الطالب لا يسجل مرتين بنفس النشاط/الفورم
  @@unique([formId, userId])
  @@index([formId, submittedAt])
  @@index([userId])
}

// =========================================================
// ACTIVITY FORM ANSWER
// =========================================================

model ActivityFormAnswer {
  id String @id @default(cuid())

  submissionId String
  questionId   String

  submission ActivityFormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  question ActivityFormQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  // أمثلة:
  //
  // Text:
  // "أحمد محمد"
  //
  // Radio:
  // "نعم"
  //
  // Checkbox:
  // ["AI", "Web", "Embedded"]
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, questionId])
  @@index([questionId])
}

// =========================================================
// DEPARTMENT GUIDE
// =========================================================

model DepartmentGuide {
  id           String @id @default(cuid())
  departmentId String @unique

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  overview      String @default("")
  fitFor        String @default("")
  careersIncome String @default("")
  skillsCourses String @default("")
  comparisons   String @default("")
  faq           String @default("")

  updatedAt DateTime @updatedAt
}

// =========================================================
// CLUB STRUCTURE
// =========================================================

model ClubStructureItem {
  id    String @id @default(cuid())
  name  String
  title String

  level     Int @default(1)
  sortOrder Int @default(0)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// COMPLAINT
// =========================================================

model Complaint {
  id String @id @default(cuid())

  studentName String?
  contact     String?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  studyLevel StudyLevel

  type       ComplaintType
  details    String
  wantsReply Boolean

  status ContactRequestStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([departmentId, createdAt])
}

// =========================================================
// SUGGESTION
// =========================================================

model Suggestion {
  id String @id @default(cuid())

  studentName String
  whatsapp    String

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  studyLevel StudyLevel

  topics String?

  activityType  PreferredActivityType
  activityLevel ExperienceLevel

  projectIdea String

  experienceLevel ExperienceLevel

  status ContactRequestStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([departmentId, createdAt])
}

// =========================================================
// COLLABORATION REQUEST
// =========================================================

model CollaborationRequest {
  id String @id @default(cuid())

  entityName String
  entityType EntityType

  contactPerson String
  phone         String
  email         String
  socialUrl     String

  cooperationType CooperationType
  description     String
  field           String

  attachmentStoredName   String?
  attachmentOriginalName String?
  attachmentMime         String?
  attachmentSize         Int?

  additionalNotes String?

  status ContactRequestStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}
